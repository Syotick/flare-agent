# Flare Agent 本地开发环境配置（复制为 .env 后按需修改；.env 不入库）
FLARE_ENV=dev
FLARE_LOG_LEVEL=INFO

# PostgreSQL（docker-compose 默认账号）
FLARE_DATABASE_URL=postgresql://flare:flare@localhost:5432/flare
# Redis
FLARE_REDIS_URL=redis://localhost:6379/0

# 对象存储（本地用 MinIO 模拟 OSS）
FLARE_OBJECT_STORE_ENDPOINT=http://localhost:9000
FLARE_OBJECT_STORE_ACCESS_KEY=minioadmin
FLARE_OBJECT_STORE_SECRET_KEY=minioadmin

# 模型（默认 mock 供应商；接入真实模型时填 API Key）
FLARE_MODEL_PROVIDER=mock
FLARE_MODEL_API_KEY=
FLARE_MODEL_BASE_URL=http://localhost:9001/v1
